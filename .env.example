OPENAI_API_KEY=

# YouTube upload (OAuth refresh-token flow)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional: path to local oauth token file for local testing
YOUTUBE_TOKEN_FILE=

# Instagram Graph API
META_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
INSTAGRAM_VIDEO_URL=

# TikTok API
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_VIDEO_URL=

# Optional runtime toggles
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM=true
ENABLE_TIKTOK=true
